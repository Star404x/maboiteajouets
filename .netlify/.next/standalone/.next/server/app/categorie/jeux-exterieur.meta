{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/categorie/layout,_N_T_/categorie/[slug]/layout,_N_T_/categorie/[slug]/page,_N_T_/categorie/jeux-exterieur"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/categorie/$d$slug/__PAGE__",
    "/categorie/$d$slug",
    "/categorie",
    "/_index",
    "/_head"
  ]
}