{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/nouveautes/layout,_N_T_/nouveautes/page,_N_T_/nouveautes"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/nouveautes/__PAGE__",
    "/nouveautes",
    "/_index",
    "/_head"
  ]
}