md:grid-cols-3 lg:grid-cols-4","children":[["$","$L2c","p-015",{"product":{"id":"p-015","slug":"balle-prehension-multicolore","name":"O-Ball - Ballon sensoriel multicolore","category":"jouets-bebe","categoryName":"Jouets bébé","description":"Le classique ballon O-Ball aux 32 anneaux entrelacés. Ses couleurs vives (bleu, vert, rouge, jaune) stimulent la perception visuelle. Idéal pour développer le réflexe de préhension et la motricité fine. Plastique souple sans BPA. À partir de la naissance.","longDescription":"$undefined","price":7.8,"oldPrice":"$undefined","rating":4.7,"reviewCount":5,"age":[],"images":["/products/balle-prehension-1.png","/products/balle-prehension-2.png","/products/balle-prehension-3.png","/products/balle-prehension-4.png","/products/balle-prehension-5.png","/products/balle-prehension-6.png","/products/balle-prehension-7.png","/products/balle-prehension-8.png","/products/balle-prehension-9.png","/products/balle-prehension-10.png"],"badge":null,"inStock":true,"stockCount":0,"materials":["Мягкий пластик (медицинский PE)","Без BPA/фталатов/латекса"],"dimensions":null,"safety":["Certifié CE","Без BPA","Можно грызть","Легко мыть"],"color":null,"bgClass":"bg-gradient-to-br from-yellow-50 to-red-50"},"priority":true}],"$L2d","$L2e"]}]]}]]}]
