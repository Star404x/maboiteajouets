# =====================================================
# Ma Boîte à Jouets — Environment variables (example)
# Copier ce fichier vers .env.local et remplir les valeurs.
# =====================================================

# Public
NEXT_PUBLIC_SITE_URL=https://maboiteajouets.fr

# ----- Stripe (paiement) -----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# ----- Newsletter (Mailchimp / Klaviyo / Brevo) -----
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# ----- Email transactionnel (Resend / SendGrid / Postmark) -----
RESEND_API_KEY=
EMAIL_FROM=info.maboiteajouets@gmail.com

# ----- Backend catalogue (au choix — laisser vide pour données locales) -----
# Shopify Storefront
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# WooCommerce REST
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Medusa
MEDUSA_BACKEND_URL=

# ----- Analytics (chargé UNIQUEMENT après consentement) -----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ----- Search (Algolia optionnel) -----
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
